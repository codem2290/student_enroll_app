{
	"_version": "1.83.0",
	"sap.app": {
		"id": "com.student.app.studentappenroll",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.22.0",
			"toolsId": "f7f751eb-cc8b-4413-b621-af81d0c94757"
		},
		"dataSources": {
			"mainService": {
				"uri": "odata/v4/student-enrollment-api/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"student_app_enroll-display": {
					"semanticObject": "student_app_enroll",
					"action": "display",
					"title": "Student Enrollment App",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.147.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.student.app.studentappenroll.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "CoursesList",
					"target": "CoursesList"
				},
				{
					"pattern": "Courses({key}):?query:",
					"name": "CoursesObjectPage",
					"target": "CoursesObjectPage"
				}
			],
			"targets": {
				"CoursesList": {
					"type": "Component",
					"id": "CoursesList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/Courses",
							"variantManagement": "Page",
							"navigation": {
								"Courses": {
									"detail": {
										"route": "CoursesObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				},
				"CoursesObjectPage": {
					"type": "Component",
					"id": "CoursesObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Courses",
							"content": {
								"header": {
									"actions": {
										"activateBtn": {
											"press": "com.student.app.studentappenroll.ext.controller.CustomActionHandler.activateCourseStatus",
											"visible": true,
											"enabled": true,
											"text": "Activate Course",
											"position": {
												"placement": "Before",
												"anchor": "EditAction"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "student_enroll_app.service"
	}
}