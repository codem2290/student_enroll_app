PROCEDURE "ReadCourseData"( 
   OUT COURSE_DATA TABLE (NAME VARCHAR(5000), DURATION INTEGER, FEES DECIMAL(10,2)),
   OUT ENROLLMENT_DATA TABLE (FEESPAID DECIMAL(10, 2), ENROLLEDDATE DATE)
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   READS SQL DATA AS
BEGIN
   /*************************************
       Write your procedure logic
   *************************************/
   COURSE_DATA = SELECT "NAME" as NAME, "DURATION" as DURATION, "FEES" as FEES FROM "APPLICATION_TABLES_COURSES";
   ENROLLMENT_DATA = SELECT "FEESPAID" as FEESPAID, "ENROLLEDDATE" as ENROLLEDDATE FROM "APPLICATION_TABLES_ENROLLMENTS";


END